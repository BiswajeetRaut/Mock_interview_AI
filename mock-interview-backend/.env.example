# Copy to .env for local development. Never commit the real .env — it's gitignored.

# Required — LLM provider for all agent reasoning/generation (agents/shared.py).
# Without this, every agent falls back to heuristic/template behavior.
GROQ_API_KEY=

# Optional — Firebase Admin credentials for auth + Firestore.
# Path to a service account JSON. If the file isn't found, firebase_admin_init.py
# falls back to an in-memory mock store (dev only — see P2-108).
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json

# Optional — Redis connection string for session persistence AND rate
# limiting (P2-106). If unset, sessions live in an in-process dict and rate
# limits are enforced per-process — both single-replica only. Production
# target is GCP Memorystore (same VPC as the cluster — see design doc D-03).
REDIS_URL=

# Optional — rate limit tuning (P2-106). Each is "N requests per capacity,
# refilling at N per minute" (a token bucket, not a hard window). Defaults
# are generous relative to real interview pacing — tune here, no redeploy
# needed, just an env change.
RATE_LIMIT_SESSION_START_CAPACITY=5
RATE_LIMIT_SESSION_START_REFILL_PER_MIN=5
RATE_LIMIT_SESSION_ANSWER_CAPACITY=30
RATE_LIMIT_SESSION_ANSWER_REFILL_PER_MIN=30
RATE_LIMIT_CODING_RUN_CAPACITY=20
RATE_LIMIT_CODING_RUN_REFILL_PER_MIN=20

# Optional — how long a session survives with no activity, in seconds.
SESSION_TTL_SECONDS=7200

# Optional — enables POST /coding/run, which executes candidate-submitted
# code via an unsandboxed subprocess. Disabled by default (P2-101) until the
# sandboxed executor (Phase 2 backlog, Epic 6) replaces it. Do not enable
# this in any shared or public-facing environment.
CODING_RUNNER_ENABLED=false

# Optional — comma-separated list of allowed frontend origins for CORS.
# Defaults to the two local Vite/CRA dev ports if unset. In staging/prod, set
# this to the real frontend domain(s) — never include "*" here (P2-105):
# allow_credentials=True makes a wildcard origin invalid per the CORS spec.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
